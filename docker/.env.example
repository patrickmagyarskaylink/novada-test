# ─── Local test stack config — copy to .env, adjust, never commit ────────────
#   cp .env.example .env && docker compose up -d --build

# ── Host ports ───────────────────────────────────────────────────────────────
# Everything (MCP, /health, OAuth, landing pages, /rest/v1) is served through
# Traefik on this single port.
HTTP_PORT=8080
# Traefik's own dashboard — unauthenticated, local only.
TRAEFIK_DASHBOARD_PORT=8090

# ── Required: KV (Upstash-REST) shared secret ────────────────────────────────
# Any string; the gateway and the SRH façade must agree. Rotate for anything
# reachable outside your laptop.
KV_REST_API_TOKEN=local-dev-token

# ── Gateway policy knobs ─────────────────────────────────────────────────────
FREE_PLAN_MONTHLY_QUOTA=1000
RATE_LIMIT_PER_MIN=60
LOG_LEVEL=info
NOVADA_API_BASE=https://api.novada.com

# ── OAuth 2.1 grant endpoints (optional) ─────────────────────────────────────
# Base64 of 32 random bytes — encrypts the caller's API key at rest in KV.
# Generate: openssl rand -base64 32
# Leave empty to run apikey/Bearer-only (/register /authorize /token fail closed).
OAUTH_ENC_KEY=
OAUTH_ISSUER=

# ── Telemetry sink (optional — `docker compose --profile telemetry up -d`) ────
# Both URL and KEY must be set or the telemetry path no-ops (fail-open).
# The URL points at Traefik, which strips /rest/v1 and forwards to PostgREST.
# TELEMETRY_SUPABASE_URL=http://traefik:80
# The values below are LOCAL-ONLY HS256 JWTs signed with TELEMETRY_JWT_SECRET.
# Regenerate after changing the secret:
#   node -e 'const c=require("crypto"),s=process.env.S,b=o=>Buffer.from(JSON.stringify(o)).toString("base64url"),h=b({alg:"HS256",typ:"JWT"}),p=b({role:process.env.R});console.log(h+"."+p+"."+c.createHmac("sha256",s).update(h+"."+p).digest("base64url"))'
# with S=<secret> R=service_role
TELEMETRY_JWT_SECRET=novada-local-dev-jwt-secret-change-me-32b
# TELEMETRY_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6Im5vdmFkYS1sb2NhbCIsImlhdCI6MTc4OTEyMTc4MX0.qO6oc3yRAXLubo7MvUD2GKFgp3KfBQHTkfkOmoXHSEY
# TELEMETRY_SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoibm92YWRhLWxvY2FsIiwiaWF0IjoxNzg5MTIxNzgxfQ.hvmXn01grwN2Wm2DCD5JErDWMXaqasXVWInMRThItaM
POSTGRES_PASSWORD=local-dev-postgres

# Base64 32-byte AES-256-GCM key for at-rest encryption of identity fields in
# the telemetry log (openssl rand -base64 32). Optional.
NOVADA_LOG_IDENTITY_AES_KEY=

# ── Upstream HQ log push + reconcile cron (optional, off by default) ─────────
NOVADA_HQ_LOG_URL=
CRON_SECRET=

# ── Error monitoring (optional) ──────────────────────────────────────────────
SENTRY_DSN=

# ── stdio profile only ───────────────────────────────────────────────────────
# The gateway needs NO key (callers bring their own); the stdio server does.
NOVADA_API_KEY=
